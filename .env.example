# ---------------------------------------------------------------------------
# APISentinel configuration. Copy to .env before running `docker compose up`.
# Every value below has a working default, so the stack runs unchanged.
# ---------------------------------------------------------------------------

# Database
POSTGRES_USER=apisentinel
POSTGRES_PASSWORD=apisentinel
POSTGRES_DB=apisentinel
POSTGRES_PORT=5433

# Ports on the host machine
BACKEND_PORT=8000
FRONTEND_PORT=3000
VULNAPI_PORT=8001
ZAP_PORT=8090

# Backend
JWT_SECRET=change-me-in-production
VITE_API_BASE_URL=http://localhost:8000

# Demo account created on first boot (set SEED_DEMO_USER=false to disable)
DEMO_USER_EMAIL=analyst@apisentinel.local
DEMO_USER_PASSWORD=apisentinel123

# ---------------------------------------------------------------------------
# LLM reasoning layer. Two interchangeable providers.
#   LLM_PROVIDER=ollama  -> fully offline / open-source (report-faithful default)
#   LLM_PROVIDER=hosted  -> any OpenAI-compatible HTTP API
#   LLM_PROVIDER=disabled -> static + runtime layers only
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Ollama: run `ollama serve` on the host, then `ollama pull qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Hosted OpenAI-compatible endpoint (used when LLM_PROVIDER=hosted)
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

# ---------------------------------------------------------------------------
# Runtime validation layer
# Only hosts listed here may be probed. Never add a production system.
# ---------------------------------------------------------------------------
RUNTIME_TARGET_ALLOWLIST=http://vulnapi:8001,http://localhost,http://127.0.0.1
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=apisentinel-zap

# ---------------------------------------------------------------------------
# URL-based (black-box) web scanning
# A project can be scanned by URL alone (scan_mode="url"), with no source
# code or SQL scripts uploaded — see docs/WEB_SCANNING.md.
# ---------------------------------------------------------------------------

# Off by default: a host that is NOT in RUNTIME_TARGET_ALLOWLIST above can
# only be scanned once this is true, AND the project owner has recorded their
# authorization for that specific target (Project.target_authorized, set via
# POST /api/projects/{id}/authorization/confirm or .../verify). Every target,
# allowlisted or not, still goes through the SSRF-safe IP check in
# app.runtime_layer.safety before a single request is sent.
ALLOW_PUBLIC_TARGETS=false

# Crawl limits: keep a scan's own request volume bounded.
WEB_MAX_PAGES=60
WEB_MAX_CRAWL_DEPTH=6
WEB_REQUEST_TIMEOUT_SECONDS=10
WEB_REQUEST_DELAY_MS=150
WEB_USER_AGENT=APISentinel-WebScanner/1.0 (+authorized-security-assessment)

# OWASP ZAP's Active Scan sends real attack payloads at the target. Off by
# default at the operator level; a scan must also opt in per-request
# (ScanCreate.run_active_scan / ScopeConfig.run_active_scan) for it to run —
# both switches are required. Spidering and passive scanning are unaffected
# by this flag.
ZAP_ENABLE_ACTIVE_SCAN=false

# JavaScript-rendered-page crawling (single-page applications) is a per-scan
# opt-in (ScopeConfig.use_playwright) with no operator-level switch needed —
# it is self-gating: if the Dockerfile's `playwright install chromium` step
# was removed, a scan that requests it simply records a warning and the rest
# of the scan proceeds normally.
